{
  "name": "@wdio/native-types",
  "version": "2.5.0",
  "description": "Type definitions for WebdriverIO Native Desktop Services (Electron and Tauri)",
  "homepage": "https://github.com/webdriverio/desktop-mobile/tree/main/packages/native-types",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": [
      {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./dist/cjs/index.js"
    ]
  },
  "engines": {
    "node": "^18.12.0 || ^20.9.0 || >=22.11.0"
  },
  "devDependencies": {
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/packager": "^20.0.4",
    "@types/node": "^26.1.2",
    "@wdio/globals": "9.29.1",
    "@wdio/types": "9.29.1",
    "builder-util": "^26.15.3",
    "electron": "42.2.0",
    "shx": "^0.4.0",
    "typescript": "^6.0.3",
    "webdriverio": "9.30.0",
    "@wdio/bundler": "0.0.0",
    "@wdio/native-spy": "1.2.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webdriverio/desktop-mobile.git",
    "directory": "packages/native-types"
  },
  "scripts": {
    "clean": "shx rm -rf dist coverage .turbo",
    "build": "node ../../scripts/build-package.ts",
    "dev": "node ../../scripts/build-package.ts --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}