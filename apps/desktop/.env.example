# Copy this file to .env.local (gitignored) and fill in real keys.
#
# Used only by the Assistant screen's showcase fallback
# (src/features/showcase_assistant/geminiRouter.ts) for requests that don't
# match a hardcoded fixture in public/demo-fixtures/. Comma-separated — the
# client rotates through them round-robin so no single key gets rate-limited
# mid-demo.
VITE_GEMINI_API_KEYS=key_one_here,key_two_here,key_three_here
